RunService.RenderStepped:Connect(function()
    if blockFovEnabled then
        FovRadius.Position = UDim2.new(0.5, 0, 0.5, 0)
    end

    if rainbowFovEnabled then
        local hue = tick() % 5 / 5
        FovRing.Color = Color3.fromHSV(hue, 1, 1)
    else
        FovRing.Color = Color3.fromRGB(255, 255, 255)
    end

    if aimbotEnabled then
        local closestTarget = nil
        local shortestDist = math.huge
        local centerPos = Vector2.new(FovRadius.AbsolutePosition.X + FovRadius.AbsoluteSize.X / 2, FovRadius.AbsolutePosition.Y + FovRadius.AbsoluteSize.Y / 2)
        local radius = FovRadius.AbsoluteSize.X / 2

        for _, p in pairs(Players:GetPlayers()) do
            if p ~= Player and p.Character and p.Character:FindFirstChild("Head") then
                local humanoid = p.Character:FindFirstChildOfClass("Humanoid")
                if humanoid and humanoid.Health > 0 then
                    local head = p.Character.Head
                    local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - centerPos).Magnitude
                        if dist <= radius and dist < shortestDist then
                            shortestDist = dist
                            closestTarget = head
                        end
                    end
                end
            end
        end

        if closestTarget then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, closestTarget.Position)
        end
    end
end)
