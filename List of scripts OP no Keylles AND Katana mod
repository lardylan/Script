-- Función para crear botones de script
local function CreateScriptButton(data)
    local btn = Instance.new("TextButton")
    btn.Name = data.Name
    btn.Size = UDim2.new(0.9, 0, 0, 40)
    btn.Text = data.Name
    btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    btn.TextColor3 = Color3.new(1,1,1)
    btn.Parent = ContentFrame
    
    btn.MouseButton1Click:Connect(function()
        print("Ejecutando: " .. data.Name)
        loadstring(game:HttpGet(data.Source))() -- Ejecuta el script directamente
    end)
    return btn
end

-- Cargar lista inicial
for _, data in pairs(ScriptsList) do
    CreateScriptButton(data)
end

-- Lógica del Buscador
SearchBar:GetPropertyChangedSignal("Text"):Connect(function()
    local query = SearchBar.Text:lower()
    for _, child in pairs(ContentFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child.Visible = child.Name:lower():find(query) ~= nil
        end
    end
end)

-- Lógica del Botón Ocultar (Loop > / <)
local isOpen = true
ToggleBtn.MouseButton1Click:Connect(function()
    isOpen = not isOpen
    if not isOpen then
        ContentFrame.Visible = false
        MainFrame:TweenSize(UDim2.new(0, 300, 0, 45), "Out", "Quad", 0.3)
        ToggleBtn.Text = "<"
    else
        MainFrame:TweenSize(UDim2.new(0, 300, 0, 350), "Out", "Quad", 0.3)
        ContentFrame.Visible = true
        ToggleBtn.Text = ">"
    end
end)
