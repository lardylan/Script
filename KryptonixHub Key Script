local OldNameCall
OldNameCall = hookmetamethod(game, "__namecall", function(Self, ...)
    local Args = {...}
    local Method = getnamecallmethod()
    
    if AntiKickEnabled and Self == LocalPlayer and (Method == "Kick" or Method == "kick") then
        return
    end
    
    return OldNameCall(Self, unpack(Args))
end)

local function GetClosestPlayerToCenter()
    local ClosestPlayer = nil
    local ShortestDistance = math.huge
    local Center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
            local pos, onScreen = Camera:WorldToViewportPoint(player.Character.HumanoidRootPart.Position)
            if onScreen then
                local dist = (Vector2.new(pos.X, pos.Y) - Center).Magnitude
                if dist < ShortestDistance then
                    ShortestDistance = dist
                    ClosestPlayer = player
                end
            end
        end
    end
    return ClosestPlayer
end

RunService.RenderStepped:Connect(function()
    if AimbotEnabled then
        local Target = GetClosestPlayerToCenter()
        if Target and Target.Character and Target.Character:FindFirstChild("Head") then
            local TargetHead = Target.Character.Head.Position
            local CurrentCamCFrame = Camera.CFrame
            Camera.CFrame = CurrentCamCFrame:Lerp(CFrame.new(CurrentCamCFrame.Position, TargetHead), 0.15)
        end
    end

    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
        local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if SpeedEnabled then
            humanoid.WalkSpeed = SpeedValue
        end
        if JumpEnabled then
            humanoid.JumpPower = JumpValue
            humanoid.UseJumpPower = true
        end
    end
end)

RunService.RenderStepped:Connect(function()
    if HitboxEnabled then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChildOfClass("Humanoid") then
                local char = player.Character
                local head = char:FindFirstChild("Head")
                
                if head then
                    if not OriginalHeadSizes[head] then
                        OriginalHeadSizes[head] = head.Size
                        OriginalTransparency[head] = head.Transparency
                    end
                    
                    head.Size = Vector3.new(5, 5, 5)
                    head.Transparency = 1
                    head.CanCollide = false
                end
            end
        end
    end
end)

local function CreateESP(player)
    local drawings = {
        Box = Drawing.new("Square"),
        Text = Drawing.new("Text")
    }
    
    drawings.Box.Visible = false
    drawings.Box.Color = Color3.fromRGB(255, 0, 0)
    drawings.Box.Thickness = 2
    drawings.Box.Filled = false

    drawings.Text.Visible = false
    drawings.Text.Color = Color3.fromRGB(255, 255, 255)
    drawings.Text.Size = 14
    drawings.Text.Center = true
    drawings.Text.Outline = true

    ESP_Drawings[player] = drawings
end

Players.PlayerAdded:Connect(CreateESP)
for _, p in pairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then CreateESP(p) end
end

Players.PlayerRemoving:Connect(function(player)
    if ESP_Drawings[player] then
        ESP_Drawings[player].Box:Remove()
        ESP_Drawings[player].Text:Remove()
        ESP_Drawings[player] = nil
    end
end)

RunService.RenderStepped:Connect(function()
    for player, drawings in pairs(ESP_Drawings) do
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
            local hrp = player.Character.HumanoidRootPart
            local vector, onScreen = Camera:WorldToViewportPoint(hrp.Position)

            if onScreen then
                local dist = math.floor((LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and (LocalPlayer.Character.HumanoidRootPart.Position - hrp.Position).Magnitude) or 0)

                if ESP_BoxEnabled then
                    drawings.Box.Size = Vector2.new(2000 / vector.Z, 3000 / vector.Z)
                    drawings.Box.Position = Vector2.new(vector.X - drawings.Box.Size.X / 2, vector.Y - drawings.Box.Size.Y / 2)
                    drawings.Box.Visible = true
                else
                    drawings.Box.Visible = false
                end

                if ESP_NameDistEnabled then
                    drawings.Text.Position = Vector2.new(vector.X, vector.Y - (3000 / vector.Z) / 2 - 15)
                    drawings.Text.Text = player.Name .. " [" .. tostring(dist) .. "m]"
                    drawings.Text.Visible = true
                else
                    drawings.Text.Visible = false
                end
            else
                drawings.Box.Visible = false
                drawings.Text.Visible = false
            end
        else
            drawings.Box.Visible = false
            drawings.Text.Visible = false
        end
    end
end)

