   end,
})

MainTab:CreateButton({
   Name = "ENTER ID (Reproducir)",
   Callback = function()
      local id = tonumber(currentId)
      if not id then
         Rayfield:Notify({
            Title = "Error",
            Content = "Ingresa un ID numérico válido",
            Duration = 3,
            Image = 4483362458,
         })
         return
      end

      task.spawn(function()
         local success, assetInfo = pcall(function()
             return MarketplaceService:GetProductInfo(id, Enum.InfoType.Asset)
         end)

         if success and assetInfo and assetInfo.AssetTypeId == 3 then
             SoundPlayer:Stop()
             SoundPlayer.SoundId = "rbxassetid://" .. id
             
             pcall(function()
                 ContentProvider:PreloadAsync({SoundPlayer})
             end)
             
             SoundPlayer:Play()
             task.wait(0.05)
             applyStartTime()

             Rayfield:Notify({
                Title = "Música Cargada",
                Content = assetInfo.Name .. " por " .. (assetInfo.Creator and assetInfo.Creator.Name or "Desconocido"),
                Duration = 4,
                Image = 4483362458,
             })
         else
             Rayfield:Notify({
                Title = "Error de Audio",
                Content = "ID inválido o bloqueado por Roblox",
                Duration = 3,
                Image = 4483362458,
             })
         end
      end)
   end,
})

