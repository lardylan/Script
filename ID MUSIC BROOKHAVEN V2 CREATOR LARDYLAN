        end
    end
end)

local function parseTime(text)
    if string.find(text, ":") then
        local m, s = text:match("(%d+):(%d+)")
        return (tonumber(m) or 0) * 60 + (tonumber(s) or 0)
    end
    return tonumber(text) or 0
end

local function applyStartTime()
    if SoundPlayer.TimeLength > 0 then
        SoundPlayer.TimePosition = math.clamp(startTime, 0, SoundPlayer.TimeLength)
    end
end

