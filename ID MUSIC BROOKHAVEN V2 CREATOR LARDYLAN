local draggingMain = false
local dragInput, dragStart, startPos

DragBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingMain = true
        dragStart = input.Position
        startPos = MainFrame.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                draggingMain = false
            end
        end)
    end
end)

DragBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UIS.InputChanged:Connect(function(input)
    if input == dragInput and draggingMain then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

local resizingTL = false
local resizingBR = false
local resizeStartPos, resizeStartSize, resizeStartMouse

ResizeTopLeft.MouseButton1Down:Connect(function()
    resizingTL = true
    resizeStartMouse = UIS:GetMouseLocation()
    resizeStartPos = MainFrame.Position
    resizeStartSize = MainFrame.Size
end)

ResizeBottomRight.MouseButton1Down:Connect(function()
    resizingBR = true
    resizeStartMouse = UIS:GetMouseLocation()
    resizeStartSize = MainFrame.Size
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        resizingTL = false
        resizingBR = false
    end
end)

RunService.RenderStepped:Connect(function()
    local mouseLoc = UIS:GetMouseLocation()
    if resizingTL then
        local delta = mouseLoc - resizeStartMouse
        local newWidth = math.clamp(resizeStartSize.X.Offset - delta.X, 260, 600)
        local newHeight = math.clamp(resizeStartSize.Y.Offset - delta.Y, 200, 700)
        MainFrame.Size = UDim2.new(0, newWidth, 0, newHeight)
        MainFrame.Position = UDim2.new(resizeStartPos.X.Scale, resizeStartPos.X.Offset + (resizeStartSize.X.Offset - newWidth), resizeStartPos.Y.Scale, resizeStartPos.Y.Offset + (resizeStartSize.Y.Offset - newHeight))
    elseif resizingBR then
        local delta = mouseLoc - resizeStartMouse
        local newWidth = math.clamp(resizeStartSize.X.Offset + delta.X, 260, 600)
        local newHeight = math.clamp(resizeStartSize.Y.Offset + delta.Y, 200, 700)
        MainFrame.Size = UDim2.new(0, newWidth, 0, newHeight)
    end
end)

