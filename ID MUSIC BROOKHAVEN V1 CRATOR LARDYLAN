	if draggingVol then
		local x = math.clamp((UIS:GetMouseLocation().X - volTrack.AbsolutePosition.X) / volTrack.AbsoluteSize.X, 0, 1)
		volKnob.Position = UDim2.fromScale(x - 0.02, 0)
		local vol = 0.1 + (x * 1.9)
		sound.Volume = vol
		volumeLabel.Text = string.format("Volume: %.1fx", vol)
	end

	if draggingScrub and sound.TimeLength > 0 then
		local x = math.clamp((UIS:GetMouseLocation().X - scrubTrack.AbsolutePosition.X) / scrubTrack.AbsoluteSize.X, 0, 1)
		scrubKnob.Position = UDim2.fromScale(x - 0.015, 0)
		sound.TimePosition = x * sound.TimeLength
	end

	if sound.IsPlaying and sound.TimeLength > 0 then
		timeLabel.Text =
			formatTime(sound.TimePosition) ..
			" / " ..
			formatTime(sound.TimeLength)

		scrubKnob.Position = UDim2.fromScale(
			sound.TimePosition / sound.TimeLength - 0.015,
			0
		)
	end
end)
