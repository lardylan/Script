end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        resizingTL = false
        resizingBR = false
    end
end)

RunService.RenderStepped:Connect(function()
    local mouseLoc = UIS:GetMouseLocation()
    if resizingTL then
        local delta = mouseLoc - resizeStartMouse
        local newWidth = math.clamp(resizeStartSize.X.Offset - delta.X, 280, 600)
        local newHeight = math.clamp(resizeStartSize.Y.Offset - delta.Y, 250, 700)
        MainFrame.Size = UDim2.new(0, newWidth, 0, newHeight)
        MainFrame.Position = UDim2.new(resizeStartPos.X.Scale, resizeStartPos.X.Offset + (resizeStartSize.X.Offset - newWidth), resizeStartPos.Y.Scale, resizeStartPos.Y.Offset + (resizeStartSize.Y.Offset - newHeight))
    elseif resizingBR then
        local delta = mouseLoc - resizeStartMouse
        local newWidth = math.clamp(resizeStartSize.X.Offset + delta.X, 280, 600)
        local newHeight = math.clamp(resizeStartSize.Y.Offset + delta.Y, 250, 700)
        MainFrame.Size = UDim2.new(0, newWidth, 0, newHeight)
    end
end)
