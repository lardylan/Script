    end

    if SoundPlayer.IsPlaying and SoundPlayer.TimeLength > 0 then
        TimeLabel.Text = formatTime(SoundPlayer.TimePosition) .. " / " .. formatTime(SoundPlayer.TimeLength)
        if not draggingScrub then
            ScrubKnob.Position = UDim2.new(SoundPlayer.TimePosition / SoundPlayer.TimeLength, -7, 0, 0)
        end
    end
end)
