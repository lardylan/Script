local function applyStartTime()
	startTime = parseTime(startBox.Text)
	if sound.TimeLength > 0 then
		sound.TimePosition = math.clamp(startTime, 0, sound.TimeLength)
	end
end

playBtn.MouseButton1Click:Connect(function()
	if songBox.Text == "" then return end
	sound.SoundId = "rbxassetid://" .. songBox.Text
	sound:Stop()
	sound:Play()
	task.wait(0.05)
	applyStartTime()
end)

