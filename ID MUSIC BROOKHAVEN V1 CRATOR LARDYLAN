local function toggleMenu()
    isMinimized = not isMinimized
    if isMinimized then
        ProfileImage.Visible = false
        SongLabel.Visible = false
        TopLine.Visible = false
        InputBox.Visible = false
        MiddleLine.Visible = false
        EnterButton.Visible = false
        StopButton.Visible = false
        
        local targetSize = UDim2.new(0, 260, 0, 35)
        local targetPos = UDim2.new(0.5, -130, 0, 10)
        TweenService:Create(MainFrame, tweenInfo, {Size = targetSize, Position = targetPos}):Play()
    else
        local targetSize = UDim2.new(0, 360, 0, 310)
        local targetPos = UDim2.new(0.5, -180, 0.5, -155)
        
        local openTween = TweenService:Create(MainFrame, tweenInfo, {Size = targetSize, Position = targetPos})
        openTween:Play()
        openTween.Completed:Connect(function()
            if not isMinimized then
                ProfileImage.Visible = true
                SongLabel.Visible = true
                TopLine.Visible = true
                InputBox.Visible = true
                MiddleLine.Visible = true
                EnterButton.Visible = true
                StopButton.Visible = true
            end
        end)
    end
end

MinimizeBtn.MouseButton1Click:Connect(toggleMenu)

CloseBtn.MouseButton1Click:Connect(function()
    local closeTween = TweenService:Create(MainFrame, tweenInfo, {
        Size = UDim2.new(0, 260, 0, 0),
        Position = UDim2.new(0.5, -130, 0, 0)
    })
    closeTween:Play()
    closeTween.Completed:Connect(function()
        ScreenGui:Destroy()
        if SoundPlayer then
            SoundPlayer:Destroy()
        end
    end)
end)

local function processAudio()
    local rawText = InputBox.Text
    local id = tonumber(rawText)

    if not id then
        SongLabel.Text = "Estado: ID inválido o falso"
        ProfileImage.Image = "rbxassetid://0"
        if SoundPlayer.IsPlaying then
            SoundPlayer:Stop()
        end
        return
    end

    SongLabel.Text = "Estado: Verificando..."

    task.spawn(function()
        local success, assetInfo = pcall(function()
            return MarketplaceService:GetProductInfo(id, Enum.InfoType.Asset)
        end)

        if success and assetInfo and assetInfo.AssetTypeId == 3 then
            local creatorName = "Roblox"
            local creatorId = assetInfo.Creator and assetInfo.Creator.Id or 1
            local creatorType = assetInfo.Creator and assetInfo.Creator.CreatorType
            
            if assetInfo.Creator then
                creatorName = assetInfo.Creator.Name or "Roblox"
            end

            if creatorType == Enum.CreatorType.User and creatorId > 0 then
                pcall(function()
                    local thumb = Players:GetUserThumbnailAsync(creatorId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
                    ProfileImage.Image = thumb
                end)
            else
                ProfileImage.Image = "rbxassetid://0"
            end
            
            SongLabel.Text = "Música: " .. assetInfo.Name .. "\nCreador ID: " .. creatorName
            
            SoundPlayer:Stop()
            SoundPlayer.SoundId = "rbxassetid://" .. id
            
            pcall(function()
                ContentProvider:PreloadAsync({SoundPlayer})
            end)
            
            SoundPlayer:Play()
        else
            SongLabel.Text = "Estado: ID falso o Roblox lo tumbó"
            ProfileImage.Image = "rbxassetid://0"
            if SoundPlayer.IsPlaying then
                SoundPlayer:Stop()
            end
        end
    end)
end

EnterButton.MouseButton1Click:Connect(processAudio)

StopButton.MouseButton1Click:Connect(function()
    if SoundPlayer.IsPlaying then
        SoundPlayer:Stop()
        SongLabel.Text = "Música: Apagada\nCreador ID: Ninguno"
        ProfileImage.Image = "rbxassetid://0"
    end
end)
