-- --- FUNCIONES DE COMBATE (UNIVERSALES) ---
local function getClosestEnemy()
    local target = nil
    local shortestDistance = math.huge
    for _, v in pairs(game.Players:GetPlayers()) do
        if v ~= player and v.Character and v.Character:FindFirstChild("Head") and (v.Team ~= player.Team or v.Team == nil) then
            local pos, onScreen = camera:WorldToViewportPoint(v.Character.Head.Position)
            if onScreen then
                local distance = (Vector2.new(pos.X, pos.Y) - Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y/2)).Magnitude
                if distance < Settings.FOV and distance < shortestDistance then
                    target = v.Character.Head
                    shortestDistance = distance
                end
            end
        end
    end
    return target
end

RunService.RenderStepped:Connect(function()
    -- AIMBOT CABEZA
    if Settings.Aimbot then
        local target = getClosestEnemy()
        if target then
            camera.CFrame = CFrame.new(camera.CFrame.Position, target.Position)
        end
    end
    -- SPIN
    if Settings.SpinSpeed > 1 then
        player.Character.HumanoidRootPart.CFrame = player.Character.HumanoidRootPart.CFrame * CFrame.Angles(0, math.rad(Settings.SpinSpeed), 0)
    end
end)

-- --- ESP Y ANTENAS ---
local function updateVisuals()
    for _, v in pairs(game.Players:GetPlayers()) do
        if v ~= player and v.Character and (v.Team ~= player.Team or v.Team == nil) then
            -- ESP (Highlight)
            if Settings.ESP then
                if not v.Character:FindFirstChild("LardylanESP") then
                    local highlight = Instance.new("Highlight", v.Character)
                    highlight.Name = "LardylanESP"; highlight.FillColor = Color3.new(1, 0, 0)
                end
            elseif v.Character:FindFirstChild("LardylanESP") then
                v.Character.LardylanESP:Destroy()
            end
            -- ANTENA AZUL
            if Settings.Antennas then
                if not v.Character:FindFirstChild("LardylanAntenna") then
                    local antenna = Instance.new("Part", v.Character)
                    antenna.Name = "LardylanAntenna"; antenna.Size = Vector3.new(0.2, 5, 0.2)
                    antenna.Color = Color3.new(0, 0, 1); antenna.CanCollide = false
                    local weld = Instance.new("Weld", antenna)
                    weld.Part0 = antenna; weld.Part1 = v.Character.Head; weld.C0 = CFrame.new(0, -2.5, 0)
                end
            elseif v.Character:FindFirstChild("LardylanAntenna") then
                v.Character.LardylanAntenna:Destroy()
            end
        end
    end
end
task.spawn(function() while task.wait(1) do updateVisuals() end end)

-- --- BOTONES DEL MENÚ ---
local function addToggle(name, y, key)
    local btn = Instance.new("TextButton", main)
    btn.Size = UDim2.new(0.8, 0, 0, 35); btn.Position = UDim2.new(0.1, 0, 0, y)
    btn.Text = name .. ": OFF"; btn.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
    btn.MouseButton1Click:Connect(function()
        Settings[key] = not Settings[key]
        btn.Text = name .. (Settings[key] and ": ON" or ": OFF")
        btn.BackgroundColor3 = Settings[key] and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(150, 0, 0)
    end)
end

