-- 6. FUNCIÓN SWITCH (IZQ ROJO / DER VERDE)
local function createSwitch(texto, posY, callback)
    local container = Instance.new("Frame", main)
    container.Size = UDim2.new(0.9, 0, 0, 40); container.Position = UDim2.new(0.05, 0, 0, posY); container.BackgroundTransparency = 1
    
    local label = Instance.new("TextLabel", container)
    label.Size = UDim2.new(0.7, 0, 1, 0); label.Text = texto; label.TextColor3 = Color3.new(0.9, 0.9, 0.9)
    label.BackgroundTransparency = 1; label.Font = "Gotham"; label.TextSize = 13; label.TextXAlignment = "Left"

    local bg = Instance.new("TextButton", container)
    bg.Size = UDim2.new(0, 44, 0, 20); bg.Position = UDim2.new(1, -48, 0.5, -10)
    bg.BackgroundColor3 = Color3.fromRGB(180, 40, 40); bg.Text = ""
    Instance.new("UICorner", bg).CornerRadius = UDim.new(1, 0)

    local circle = Instance.new("Frame", bg)
    circle.Size = UDim2.new(0, 16, 0, 16); circle.Position = UDim2.new(0, 2, 0.5, -8)
    circle.BackgroundColor3 = Color3.new(1, 1, 1); Instance.new("UICorner", circle).CornerRadius = UDim.new(1, 0)

    local active = false
    bg.MouseButton1Click:Connect(function()
        active = not active
        TweenService:Create(circle, TweenInfo.new(0.15), {Position = active and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)}):Play()
        TweenService:Create(bg, TweenInfo.new(0.15), {BackgroundColor3 = active and Color3.fromRGB(40, 180, 40) or Color3.fromRGB(180, 40, 40)}):Play()
        callback(active)
    end)
end

-- 7. FUNCIÓN SLIDER (ARRASTRE REAL)
local function createSlider(texto, posY, max, callback)
    local lab = Instance.new("TextLabel", main)
    lab.Size = UDim2.new(0.9, 0, 0, 20); lab.Position = UDim2.new(0.05, 0, 0, posY)
    lab.Text = texto .. ": 1 |--------------- " .. max; lab.TextColor3 = Color3.new(1,1,1); lab.BackgroundTransparency = 1

    local bar = Instance.new("Frame", main)
    bar.Size = UDim2.new(0.8, 0, 0, 4); bar.Position = UDim2.new(0.1, 0, 0, posY + 25); bar.BackgroundColor3 = Color3.new(0.4, 0.4, 0.4)
    
    local knob = Instance.new("TextButton", bar)
    knob.Size = UDim2.new(0, 12, 0, 20); knob.Position = UDim2.new(0, 0, 0.5, -10)
    knob.Text = "|"; knob.BackgroundColor3 = Color3.new(1, 0, 0); knob.TextColor3 = Color3.new(1, 1, 1)

    local dragging = false
    knob.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true end end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local relX = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
            knob.Position = UDim2.new(relX, -6, 0.5, -10)
            local val = math.floor(relX * max); if val < 1 then val = 1 end
            lab.Text = texto .. ": " .. val .. " |" .. string.rep("-", 10) .. " " .. max
            callback(val)
        end
    end)
    UserInputService.InputEnded:Connect(function() dragging = false end)
end

-- 8. LÓGICA DE ANTENAS GIGANTES Y ESP
RunService.RenderStepped:Connect(function()
    for _, p in pairs(game.Players:GetPlayers()) do
        if p ~= player and p.Character and p.Character:FindFirstChild("Head") then
            local isEnemy = (p.Team ~= player.Team or p.Team == nil)
            -- Antena Gigante al Cielo
            if Settings.Antenas and isEnemy then
                if not p.Character.Head:FindFirstChild("AntenaLardy") then
                    local a = Instance.new("BoxHandleAdornment", p.Character.Head)
                    a.Name = "AntenaLardy"; a.Size = Vector3.new(0.5, 5000, 0.5) -- GIGANTE
                    a.Adornee = p.Character.Head; a.Color3 = Color3.new(0, 0, 1) -- AZUL
                    a.AlwaysOnTop = true; a.ZIndex = 10
                end
            elseif p.Character.Head:FindFirstChild("AntenaLardy") then
                p.Character.Head.AntenaLardy:Destroy()
            end
        end
    end
end)

