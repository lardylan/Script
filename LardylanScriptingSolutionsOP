local function createToggle(name, posY, callback)
    local btn = Instance.new("TextButton", content)
    btn.Size = UDim2.new(0.9, 0, 0, 35)
    btn.Position = UDim2.new(0.05, 0, 0, posY)
    btn.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
    btn.Text = name .. ": OFF"
    btn.TextColor3 = Color3.new(1,1,1)
    Instance.new("UICorner", btn)
    
    local state = false
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.Text = name .. (state and ": ON" or ": OFF")
        btn.BackgroundColor3 = state and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(150, 0, 0)
        callback(state)
    end)
end

local function createSlider(name, posY, min, max, callback)
    local label = Instance.new("TextLabel", content)
    label.Size = UDim2.new(0.9, 0, 0, 20)
    label.Position = UDim2.new(0.05, 0, 0, posY)
    label.Text = name .. ": " .. min
    label.TextColor3 = Color3.new(1,1,1)
    label.BackgroundTransparency = 1
    
    local sliderBG = Instance.new("Frame", content)
    sliderBG.Size = UDim2.new(0.8, 0, 0, 10)
    sliderBG.Position = UDim2.new(0.1, 0, 0, posY + 25)
    sliderBG.BackgroundColor3 = Color3.new(0.2, 0.2, 0.2)
    
    local fill = Instance.new("TextButton", sliderBG)
    fill.Size = UDim2.new(0, 10, 1, 0)
    fill.Text = "|"
    fill.BackgroundColor3 = Color3.new(1, 0, 0)
    
    fill.MouseButton1Click:Connect(function()
        -- Lógica simplificada de slider al tocar el "|"
        local currentVal = tonumber(label.Text:match("%d+"))
        local nextVal = currentVal + 50
        if nextVal > max then nextVal = min end
        label.Text = name .. ": " .. nextVal
        callback(nextVal)
    end)
end

