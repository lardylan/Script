-- Bucle animado para los puntos (...)
task.spawn(function()
	local dots = {".", "..", "...", "...."}
	local index = 1
	while LoadingFrame.Parent and LoadingFrame.Visible do
		LoadingText.Text = "NexxuzHub Cargando" .. dots[index]
		index = (index % #dots) + 1
		task.wait(0.4)
	end
end)

