-- Función para aplicar IDs de imagen de forma segura en ejecutores
local function applyImageAsset(imageObject, rawId)
	local idStr = tostring(rawId):gsub("%D", "") -- Limpiar caracteres no numéricos
	imageObject.Image = "rbxthumb://type=Asset&id=" .. idStr .. "&w=420&h=420"
end

