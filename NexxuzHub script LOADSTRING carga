local function copyToClipboard(text)
	if setclipboard then
		setclipboard(text)
	elseif toclipboard then
		toclipboard(text)
	end
end

-- Evento Botón Cerrar
CloseButton.MouseButton1Click:Connect(function()
	ScreenGui:Destroy()
end)

-- Evento Botón Ícono Discord
DiscordIconButton.MouseButton1Click:Connect(function()
	copyToClipboard("https://discord.gg/J6FGyeNCN")
	DiscordCopiedText.Visible = true
	task.delay(2, function()
		DiscordCopiedText.Visible = false
	end)
end)

-- Evento Botón COPIE
