-- [[ INTERRUPTOR (TOGGLE) DE ACTIVACIÓN ]]
local FarmToggle = FarmTab:CreateToggle({
    Name = "Activar Farmeo Intensivo",
    CurrentValue = false,
    Callback = function(Value)
        _G.AutoFarm = Value
        if Value then
            task.spawn(function()
                while _G.AutoFarm do
                    task.wait(0.1)
                    
                    local npc = obtenerNpcCercano()
                    local char = LocalPlayer.Character
                    
                    if npc and char and char:FindFirstChild("HumanoidRootPart") then
                        local tool = LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
                        if tool then
                            char.Humanoid:EquipTool(tool)
                        end
                        
                        char.HumanoidRootPart.CFrame = npc.HumanoidRootPart.CFrame * CFrame.new(0, _G.DistanciaFarm, 0)
                        
                        VirtualUser:CaptureController()
                        VirtualUser:ClickButton1(Vector2.new(0,0))
                    end
                end
            end)
        end
    end,
})
