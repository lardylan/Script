-- [[ FUNCIÓN PARA BUSCAR EL NPC MÁS CERCANO ]]
local function obtenerNpcCercano()
    local mejorNpc = nil
    local menorDistancia = math.huge
    local miPosicion = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    
    if not miPosicion then return nil end

    for _, npc in pairs(workspace.Enemies:GetChildren()) do
        if npc:FindFirstChild("Humanoid") and npc.Humanoid.Health > 0 then
            local root = npc:FindFirstChild("HumanoidRootPart")
            if root then
                local distancia = (miPosicion.Position - root.Position).Magnitude
                if distancia < menorDistancia then
                    menorDistancia = distancia
                    mejorNpc = npc
                end
            end
        end
    end
    return mejorNpc
end

