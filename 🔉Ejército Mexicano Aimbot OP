-- Configuración de Variables
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera
local Mouse = LocalPlayer:GetMouse()

local AimbotEnabled = false

-- 1. CREACIÓN DE LA INTERFAZ (Botón y Texto Inferior)
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Parent = game.CoreGui

-- Botón Flotante AIMBOT
local ToggleButton = Instance.new("TextButton")
ToggleButton.Name = "AimbotButton"
ToggleButton.Parent = ScreenGui
ToggleButton.BackgroundColor3 = Color3.fromRGB(0, 100, 0) -- Verde militar
ToggleButton.Position = UDim2.new(0.1, 0, 0.5, 0)
ToggleButton.Size = UDim2.new(0, 120, 0, 40)
ToggleButton.Text = "AIMBOT: OFF"
ToggleButton.TextColor3 = Color3.new(1, 1, 1)
ToggleButton.Font = Enum.Font.SourceSansBold
ToggleButton.TextSize = 20
ToggleButton.Draggable = true -- Para que sea flotante y movible

-- Texto "Ejército Mexicano" Gigante abajo
local FooterText = Instance.new("TextLabel")
FooterText.Parent = ScreenGui
FooterText.BackgroundTransparency = 1
FooterText.Position = UDim2.new(0, 0, 0.85, 0)
FooterText.Size = UDim2.new(1, 0, 0, 100)
FooterText.Text = "🔉 Ejército Mexicano"
FooterText.TextColor3 = Color3.new(1, 0, 0) -- Rojo intenso
