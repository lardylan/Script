local currentSound = nil
local masterVolume = 1
local currentTargetType = "Character" 

local function removeMusic()
    if currentSound then
        currentSound:Destroy()
        currentSound = nil
    end
end

local function getTargetParent()
    local char = LocalPlayer.Character
    if not char then return nil end

    if currentTargetType == "Car" then
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid and humanoid.SeatPart and humanoid.SeatPart:IsA("VehicleSeat") then
            return humanoid.SeatPart.Parent 
        end
        return char:FindFirstChild("HumanoidRootPart") or char
    elseif currentTargetType == "Plane" then
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid and humanoid.SeatPart then
            return humanoid.SeatPart.Parent
        end
        return char:FindFirstChild("HumanoidRootPart") or char
    elseif currentTargetType == "Skate" then
        local skate = char:FindFirstChild("Skateboard") or char:FindFirstChild("Skate")
        if skate then return skate end
        return char:FindFirstChild("HumanoidRootPart") or char
    else
        return char:FindFirstChild("HumanoidRootPart") or char
    end
end

local function playMusic(soundId)
    removeMusic()
    if not soundId or soundId == "" then return end

    local parentObj = getTargetParent()
    if not parentObj then return end

    local sound = Instance.new("Sound")
    sound.Name = "GlobalServerAudio"
    sound.SoundId = "rbxassetid://" .. tostring(soundId)
    sound.Volume = masterVolume
    sound.Looped = true
    sound.RollOffMaxDistance = 150
    sound.RollOffMinDistance = 10
    sound.Parent = parentObj

    sound:Play()
    currentSound = sound
end

