        end
        task.wait(0.4)
    end
end)

local function animateGuiIn()
    MainGui.Visible = true
    MainGui.BackgroundTransparency = 1
    MainStroke.Transparency = 1
    
    local tweenInfo = TweenInfo.new(1.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    TweenService:Create(MainGui, tweenInfo, {BackgroundTransparency = 0}):Play()
    TweenService:Create(MainStroke, tweenInfo, {Transparency = 0}):Play()
end

local function animateGuiOut(hideButton)
    local tweenInfo = TweenInfo.new(1.0, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
    local tw1 = TweenService:Create(MainGui, tweenInfo, {BackgroundTransparency = 1})
    local tw2 = TweenService:Create(MainStroke, tweenInfo, {Transparency = 1})
    
    tw1:Play()
    tw2:Play()
    
    tw1.Completed:Wait()
    MainGui.Visible = false
    TargetGui.Visible = false
    
    if hideButton then
        OpenButton.Visible = false
        ScreenGui:Destroy()
    else
        OpenButton.Visible = true
    end
end

local function startCustomLoading()
    LoadingFrame.Visible = true
    OpenButton.Visible = false
    BarFill.Size = UDim2.new(0, 0, 1, 0)
    
    task.spawn(function()
        local tween89 = TweenService:Create(BarFill, TweenInfo.new(20, Enum.EasingStyle.Linear), {Size = UDim2.new(0.89, 0, 1, 0)})
        tween89:Play()
        tween89.Completed:Wait()
        
        local tween90 = TweenService:Create(BarFill, TweenInfo.new(10, Enum.EasingStyle.Linear), {Size = UDim2.new(0.90, 0, 1, 0)})
        tween90:Play()
        tween90.Completed:Wait()
        
        for pct = 91, 100 do
            local tweenStep = TweenService:Create(BarFill, TweenInfo.new(19, Enum.EasingStyle.Linear), {Size = UDim2.new(pct / 100, 0, 1, 0)})
            tweenStep:Play()
            tweenStep.Completed:Wait()
        end
        
        LoadingFrame.Visible = false
        animateGuiIn()
    end)
end

