-- 3. CUADRO DE CONFIRMACIÓN (EXIT)
local function createConfirmMenu()
    local confirmFrame = Instance.new("Frame")
    confirmFrame.Size = UDim2.new(0, 200, 0, 120)
    confirmFrame.Position = UDim2.new(0.5, -100, 0.5, -60)
    confirmFrame.BackgroundColor3 = Color3.new(0,0,0)
    confirmFrame.BorderSizePixel = 2
    confirmFrame.Parent = screenGui

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0.5, 0)
    title.Text = "ARE YOU SURE YOU WANT TO EXIT THE SCRIPT?"
    title.TextColor3 = Color3.new(1,1,1)
    title.TextWrapped = true
    title.BackgroundTransparency = 1
    title.Parent = confirmFrame

    local yesBtn = Instance.new("TextButton")
    yesBtn.Size = UDim2.new(0.4, 0, 0.3, 0)
    yesBtn.Position = UDim2.new(0.05, 0, 0.6, 0)
    yesBtn.Text = "YES"
    yesBtn.BackgroundColor3 = Color3.new(0.6, 0, 0)
    yesBtn.Parent = confirmFrame
    yesBtn.MouseButton1Click:Connect(function() screenGui:Destroy() end)

    local noBtn = Instance.new("TextButton")
    noBtn.Size = UDim2.new(0.4, 0, 0.3, 0)
    noBtn.Position = UDim2.new(0.55, 0, 0.6, 0)
    noBtn.Text = "NO"
    noBtn.BackgroundColor3 = Color3.new(0, 0.6, 0)
    noBtn.Parent = confirmFrame
    noBtn.MouseButton1Click:Connect(function() confirmFrame:Destroy() end)
end

closeX.MouseButton1Click:Connect(createConfirmMenu)

-- 4. LÓGICA DE CARGA (20 MINUTOS)
task.spawn(function()
    local totalCycles = 20
    for cycle = 1, totalCycles do
        for sec = 0, 60 do
            local percent = (sec / 60) * 100
            loadText.Text = string.format("CARGANDO: %04.1f%% [%d/%d]", percent, cycle, totalCycles)
            
            local pos = math.floor((sec / 60) * 10)
            ballBar.Text = string.rep("-", pos) .. "⚪" .. string.rep("-", 10 - pos)
            task.wait(1)
        end
    end
    blackFrame:Destroy() -- Quita el negro
    mainFrame.Visible = true -- Muestra el menú
end)

-- 5. FUNCIONES DE KORBLOX Y HEADLESS (VISIBLES)
korbloxBtn.MouseButton1Click:Connect(function()
    local char = player.Character
    if char then
        -- Simulación visual de pierna Korblox (Remover pierna derecha)
        if char:FindFirstChild("RightUpperLeg") then
            char.RightUpperLeg:Destroy()
            char.RightLowerLeg:Destroy()
            char.RightFoot:Destroy()
        elseif char:FindFirstChild("Right Leg") then
            char["Right Leg"]:Destroy()
        end
    end
end)

headlessBtn.MouseButton1Click:Connect(function()
    local char = player.Character
    if char and char:FindFirstChild("Head") then
        char.Head.Transparency = 1
        if char.Head:FindFirstChild("face") then
            char.Head.face.Transparency = 1
        end
    end
end)
