-- SERVICIOS
local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local player = Players.LocalPlayer

-- CREACIÓN DE LA BASE (PANTALLA NEGRA)
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "CustomScriptSystem"
screenGui.Parent = CoreGui

local blackFrame = Instance.new("Frame")
blackFrame.Size = UDim2.new(1, 0, 1, 0)
blackFrame.BackgroundColor3 = Color3.new(0, 0, 0)
blackFrame.ZIndex = 10
blackFrame.Parent = screenGui

-- BARRA DE CARGA
local loadingText = Instance.new("TextLabel")
loadingText.Size = UDim2.new(0, 200, 0, 50)
loadingText.Position = UDim2.new(0.5, -100, 0.7, 0)
loadingText.BackgroundTransparency = 1
loadingText.TextColor3 = Color3.new(1, 1, 1)
loadingText.Text = "Cargando: 0.0% (1/20)"
loadingText.ZIndex = 11
loadingText.Parent = blackFrame

-- LÓGICA DE CARGA (20 minutos aprox según tu pedido)
task.spawn(function()
    for i = 1, 20 do
        for percent = 0, 100, 0.5 do
            loadingText.Text = string.format("Cargando: %.1f%% (%d/20)", percent, i)
            task.wait(0.6) -- Ajustado para durar el tiempo solicitado
        end
    end
    blackFrame:Destroy() -- Desaparece al terminar
end)

-- PANEL PRINCIPAL (MOVIBLE)
local mainFrame = Instance.new("Frame")
mainFrame.Size = UDim2.new(0, 150, 0, 120)
mainFrame.Position = UDim2.new(0.1, 0, 0.4, 0)
mainFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
mainFrame.Active = true
mainFrame.Draggable = true -- Permite moverlo con el dedo/mouse
mainFrame.Parent = screenGui

local layout = Instance.new("UIListLayout")
layout.Parent = mainFrame
layout.Padding = UDim.new(0, 2)

-- BOTÓN CERRAR (X)
local closeBtn = Instance.new("TextButton")
closeBtn.Size = UDim2.new(0, 30, 0, 30)
closeBtn.Position = UDim2.new(1, -30, 0, -30)
closeBtn.Text = "X"
closeBtn.BackgroundColor3 = Color3.new(1, 0, 0)
closeBtn.Parent = mainFrame

-- SISTEMA DE CONFIRMACIÓN AL SALIR
closeBtn.MouseButton1Click:Connect(function()
    local confirmFrame = Instance.new("Frame")
    confirmFrame.Size = UDim2.new(0, 200, 0, 100)
    confirmFrame.Position = UDim2.new(0.5, -100, 0.5, -50)
    confirmFrame.BackgroundColor3 = Color3.new(0.1, 0.1, 0.1)
    confirmFrame.Parent = screenGui

    local txt = Instance.new("TextLabel")
    txt.Size = UDim2.new(1, 0, 0.6, 0)
    txt.Text = "ARE YOU SURE YOU WANT TO EXIT THE SCRIPT?"
    txt.TextColor3 = Color3.new(1,1,1)
    txt.TextWrapped = true
    txt.Parent = confirmFrame

    local yes = Instance.new("TextButton")
    yes.Size = UDim2.new(0.5, 0, 0.4, 0)
    yes.Position = UDim2.new(0, 0, 0.6, 0)
    yes.Text = "YES"
    yes.BackgroundColor3 = Color3.new(0.5, 0, 0)
    yes.Parent = confirmFrame
    yes.MouseButton1Click:Connect(function() screenGui:Destroy() end)

    local no = Instance.new("TextButton")
    no.Size = UDim2.new(0.5, 0, 0.4, 0)
    no.Position = UDim2.new(0.5, 0, 0.6, 0)
    no.Text = "NO"
    no.BackgroundColor3 = Color3.new(0, 0.5, 0)
    no.Parent = confirmFrame
    no.MouseButton1Click:Connect(function() confirmFrame:Destroy() end)
end)

-- BOTONES KORBLOX Y HEADLESS
local function createBtn(name, color)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 40)
    btn.Text = name
    btn.BackgroundColor3 = color
    btn.TextColor3 = Color3.new(1,1,1)
    btn.Parent = mainFrame
    return btn
end

local korbloxBtn = createBtn("KORBLOX", Color3.fromRGB(0, 100, 200))
local headlessBtn = createBtn("HEADLESS", Color3.fromRGB(50, 50, 50))

-- FUNCIONES COSMÉTICAS
korbloxBtn.MouseButton1Click:Connect(function()
    local char = player.Character
    if char and char:FindFirstChild("RightLeg") then
        char.RightLeg:Destroy() -- Ejemplo simple de remover pierna
        -- Nota: La malla específica de Korblox requiere cargar el ID del asset
    end
end)

headlessBtn.MouseButton1Click:Connect(function()
    local char = player.Character
    if char and char:FindFirstChild("Head") then
        char.Head.Transparency = 1
        if char.Head:FindFirstChild("face") then char.Head.face.Transparency = 1 end
    end
end)
