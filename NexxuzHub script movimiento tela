local function copyDiscordLink()
	local discordURL = "https://discord.gg/J6FGyeNCN"
	if setclipboard then
		setclipboard(discordURL)
	elseif toclipboard then
		toclipboard(discordURL)
	end
end

discordBtnKey.MouseButton1Click:Connect(copyDiscordLink)
discordBtnMain.MouseButton1Click:Connect(copyDiscordLink)

local function configurarPersonaje()
	local character = LocalPlayer.Character
	if not character then return end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.AutoRotate = not activo
	end
end

telaToggleBtn.MouseButton1Click:Connect(function()
	activo = not activo

	telaToggleBtn.Text = activo and "DESACTIVAR" or "ACTIVAR"
	telaToggleBtn.BackgroundColor3 = activo
		and Color3.fromRGB(190, 40, 40)
		or Color3.fromRGB(30, 150, 60)

	configurarPersonaje()

	if conexion then
		conexion:Disconnect()
		conexion = nil
	end

	if activo then
		conexion = RunService.RenderStepped:Connect(function()
			local character = LocalPlayer.Character
			if not character then return end

			local humanoid = character:FindFirstChildOfClass("Humanoid")
			local root = character:FindFirstChild("HumanoidRootPart")

			if not humanoid or not root then return end

			local direction = humanoid.MoveDirection

			if direction.Magnitude > 0.05 then
				local flatDirection = Vector3.new(
					direction.X,
					0,
					direction.Z
				)

				if flatDirection.Magnitude > 0 then
					root.CFrame = CFrame.lookAt(
						root.Position,
						root.Position + flatDirection.Unit
					)
				end
			end
		end)
	end
end)

LocalPlayer.CharacterAdded:Connect(function()
	task.wait(1)
	configurarPersonaje()
end)

