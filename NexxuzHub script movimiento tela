-- ESP LINES (DRAWING API COMPATIBLE)
---------------------------------------------------------
local linesPool = {}

local function getLine()
	if not Drawing then return nil end
	local l = Drawing.new("Line")
	l.Color = Color3.fromRGB(255, 255, 255)
	l.Thickness = 1.5
	l.Transparency = 1
	return l
end

local function clearDrawingLines()
	for _, l in ipairs(linesPool) do
		pcall(function() l:Remove() end)
	end
	linesPool = {}
end

---------------------------------------------------------
-- BUCLE PRINCIPAL (RENDERSTEPPED SAFE)
---------------------------------------------------------
RunService.RenderStepped:Connect(function()
	clearDrawingLines()

	if not Camera then
		Camera = workspace.CurrentCamera
		return
	end

	if isLockedCenter then
		fovFrame.Position = UDim2.new(0.5, -fovRadius, 0.5, -fovRadius)
	end

	local fovCenter = Vector2.new(
		fovFrame.AbsolutePosition.X + fovRadius,
		fovFrame.AbsolutePosition.Y + fovRadius
	)

	local targetHead = nil
	local shortestDist = fovRadius

	for _, player in ipairs(Players:GetPlayers()) do
		if isEnemy(player) and player.Character then
			local char = player.Character
			local head = char:FindFirstChild("Head")
			local hum = char:FindFirstChildOfClass("Humanoid")

			if hum and hum.Health > 0 and head then
				local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)

				if aimbotEnabled and onScreen then
					local dist = (Vector2.new(screenPos.X, screenPos.Y) - fovCenter).Magnitude
					if dist < shortestDist then
						shortestDist = dist
						targetHead = head
					end
				end

				-- ESP Box (Highlight)
				local highlight = char:FindFirstChild("NexxuzHighlight")
				if espBoxEnabled then
					if not highlight then
						highlight = Instance.new("Highlight")
						highlight.Name = "NexxuzHighlight"
						highlight.FillTransparency = 1
						highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
						highlight.OutlineTransparency = 0
						highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
						highlight.Parent = char
					end
				else
					if highlight then highlight:Destroy() end
				end

				-- ESP Line (Drawing API)
				if espLineEnabled and onScreen and Drawing then
					local line = getLine()
					if line then
						line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
						line.To = Vector2.new(screenPos.X, screenPos.Y)
						line.Visible = true
						table.insert(linesPool, line)
					end
				end
			end
		else
			if player.Character and player.Character:FindFirstChild("NexxuzHighlight") then
				player.Character.NexxuzHighlight:Destroy()
			end
		end
	end

	if aimbotEnabled and targetHead then
		Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHead.Position)
	end
end)

