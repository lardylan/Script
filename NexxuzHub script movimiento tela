-- 4. ANIMACIÓN LENTA DE MINIMIZAR / EXPANDIR
---------------------------------------------------------
local isMinimized = false
local isAnimating = false

local tweenInfo = TweenInfo.new(
	0.5,
	Enum.EasingStyle.Quart,
	Enum.EasingDirection.Out
)

minimizeBtn.MouseButton1Click:Connect(function()
	if isAnimating then return end
	isAnimating = true

	if not isMinimized then
		minimizeBtn.Text = "+"
		local tweenSize = TweenService:Create(mainFrame, tweenInfo, {Size = UDim2.new(0, 330, 0, 40)})
		local tweenAlpha = TweenService:Create(contentContainer, tweenInfo, {GroupTransparency = 1})

		tweenSize:Play()
		tweenAlpha:Play()

		tweenSize.Completed:Connect(function()
			contentContainer.Visible = false
			isMinimized = true
			isAnimating = false
		end)
	else
		minimizeBtn.Text = "-"
		contentContainer.Visible = true
		local tweenSize = TweenService:Create(mainFrame, tweenInfo, {Size = UDim2.new(0, 330, 0, 200)})
		local tweenAlpha = TweenService:Create(contentContainer, tweenInfo, {GroupTransparency = 0})

		tweenSize:Play()
		tweenAlpha:Play()

		tweenSize.Completed:Connect(function()
			isMinimized = false
			isAnimating = false
		end)
	end
end)

