-- --------------------------------------------------------------------
-- HITBOX EQUILIBRADA (LEFT, RIGHT, CENTER)
-- --------------------------------------------------------------------
task.spawn(function()
   while true do
      task.wait(0.2)
      pcall(function()
         for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
               local rootPart = player.Character:FindFirstChild("HumanoidRootPart")
               local head = player.Character:FindFirstChild("Head")
               local torso = player.Character:FindFirstChild("Torso") or player.Character:FindFirstChild("UpperTorso")
               local lowerTorso = player.Character:FindFirstChild("LowerTorso")
               
               local leftArm = player.Character:FindFirstChild("Left Arm") or player.Character:FindFirstChild("LeftHand") or player.Character:FindFirstChild("LeftLowerArm")
               local rightArm = player.Character:FindFirstChild("Right Arm") or player.Character:FindFirstChild("RightHand") or player.Character:FindFirstChild("RightLowerArm")
               local leftLeg = player.Character:FindFirstChild("Left Leg") or player.Character:FindFirstChild("LeftFoot") or player.Character:FindFirstChild("LeftLowerLeg")
               local rightLeg = player.Character:FindFirstChild("Right Leg") or player.Character:FindFirstChild("RightFoot") or player.Character:FindFirstChild("RightLowerLeg")
               
               if rootPart then
                  local selectionBox = rootPart:FindFirstChild("VisualHitbox")
                  
                  if hitboxEnabled then
                     rootPart.Size = Vector3.new(7, 7, 7)
                     rootPart.Transparency = 0.6
                     rootPart.CanCollide = false
                     
                     if head then head.Size = Vector3.new(3, 3, 3) end
                     if torso then torso.Size = Vector3.new(5, 4, 4) end
                     if lowerTorso then lowerTorso.Size = Vector3.new(5, 3, 4) end
                     
                     if leftArm then leftArm.Size = Vector3.new(3, 5, 3) end
                     if rightArm then rightArm.Size = Vector3.new(3, 5, 3) end
                     if leftLeg then leftLeg.Size = Vector3.new(3, 5, 3) end
                     if rightLeg then rightLeg.Size = Vector3.new(3, 5, 3) end
                     
                     if not selectionBox then
                        selectionBox = Instance.new("SelectionBox")
                        selectionBox.Name = "VisualHitbox"
                        selectionBox.Adornee = rootPart
                        selectionBox.Color3 = Color3.fromRGB(255, 0, 0)
                        selectionBox.LineThickness = 0.06
                        selectionBox.SurfaceTransparency = 0.85
                        selectionBox.Parent = rootPart
                     end
                     selectionBox.Visible = true
                  else
                     rootPart.Size = Vector3.new(2, 2, 1)
                     rootPart.Transparency = 1
                     rootPart.CanCollide = true
                     
                     if head then head.Size = Vector3.new(1.2, 1.2, 1.2) end
                     if torso then torso.Size = Vector3.new(2, 2, 1) end
                     if lowerTorso then lowerTorso.Size = Vector3.new(2, 1, 1) end
                     
                     if leftArm then leftArm.Size = Vector3.new(1, 2, 1) end
                     if rightArm then rightArm.Size = Vector3.new(1, 2, 1) end
                     if leftLeg then leftLeg.Size = Vector3.new(1, 2, 1) end
                     if rightLeg then rightLeg.Size = Vector3.new(1, 2, 1) end
                     
                     if selectionBox then selectionBox.Visible = false end
                  end
               end
            end
         end
      end)
   end
end)

-- --------------------------------------------------------------------
-- MODO CARTOON & ANTI-LAG (SIN TIRONES)
-- --------------------------------------------------------------------
local function applyCartoonGraphics()
   pcall(function()
      Lighting.GlobalShadows = false
      Lighting.Brightness = 2
      Lighting.OutdoorAmbient = Color3.fromRGB(150, 150, 150)
      
      -- Eliminar efectos pesados en tiempo real y limpiar texturas para efecto plano estilo dibujo
      for _, v in ipairs(workspace:GetDescendants()) do
         if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") or v:IsA("Fire") or v:IsA("Smoke") then
            v:Destroy()
         elseif v:IsA("Texture") or v:IsA("Decal") then
            v.Transparency = 1
         elseif v:IsA("BasePart") then
            v.Material = Enum.Material.SmoothPlastic -- Da el acabado liso tipo cartoon/cel-shading
         end
      end
   end)
end

-- --------------------------------------------------------------------
-- SILENT AIM Y AUTO SHOOT
-- --------------------------------------------------------------------
local function getClosestEnemy()
   local closestPlayer = nil
   local shortestDistance = math.huge

   for _, player in ipairs(Players:GetPlayers()) do
      if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
         local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
         if humanoid and humanoid.Health > 0 then
            local pos, onScreen = Camera:WorldToViewportPoint(player.Character.HumanoidRootPart.Position)
            if onScreen then
               local distance = (Vector2.new(pos.X, pos.Y) - Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)).Magnitude
               if distance < shortestDistance then
                  shortestDistance = distance
                  closestPlayer = player
               end
            end
         end
      end
   end
   return closestPlayer
end

RunService.RenderStepped:Connect(function()
   local target = getClosestEnemy()
   if target and target.Character and target.Character:FindFirstChild("Head") then
      local targetHead = target.Character.Head
      
      if silentAimEnabled then
         Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHead.Position)
      end
      
      if autoShootEnabled and ShootGunRemote and ReplicateShotRemote then
         pcall(function()
            ShootGunRemote:FireServer(targetHead.Position)
            ReplicateShotRemote:FireServer(targetHead.Position)
            if GameEventClient then
               firesignal(GameEventClient.OnClientEvent, "Gun")
            end
         end)
      end
   end
end)

