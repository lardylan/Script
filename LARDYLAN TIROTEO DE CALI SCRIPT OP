-- ====================================================================
-- SISTEMA DE GUARDADO LOCAL (Para guardar estados al salir y entrar)
-- Nota: Funciona si el ejecutor soporta las funciones writefile/readfile
-- ====================================================================
local fileName = "FarmMoneyConfig.txt"
local function saveState(state)
    if writefile then
        local data = {farmActive = state}
        pcall(function()
            writefile(fileName, HttpService:JSONEncode(data))
        end)
    end
end

local function loadState()
    if readfile and isfile and isfile(fileName) then
        local success, result = pcall(function()
            return HttpService:JSONDecode(readfile(fileName))
        end)
        if success and result then
            return result.farmActive
        end
    end
    return false -- Por defecto inicia desactivado
end

-- ====================================================================
-- LOGICA DEL LEADERSTATS Y REMOTEEVENT
-- ====================================================================
local isFarming = false
local leaderstats = localPlayer:WaitForChild("leaderstats", 5)
local moneyValue = leaderstats and (leaderstats:FindFirstChild("Money") or leaderstats:FindFirstChild("Dinero") or leaderstats:FindFirstChild("Cash"))

-- Crear un RemoteEvent simulado localmente exigido en la orden
local fakeRemote = Instance.new("RemoteEvent")
fakeRemote.Name = "FarmEvent"

-- Bucle de Dinero Rápido
local function startFarming()
    isFarming = true
    task.spawn(function()
        while isFarming do
            if moneyValue then
                -- Sube el número de forma masiva y veloz
                moneyValue.Value = moneyValue.Value + 250
            end
            task.wait(0.05) -- Velocidad extrema de subida
        end
    end)
end

local function stopFarming()
    isFarming = false
end

-- Simulación de recepción del RemoteEvent local
fakeRemote.OnClientEvent:Connect(function(action)
    if action == "START" then
        startFarming()
    elseif action == "STOP" then
        stopFarming()
    end
end)

-- Actualizar visualmente los colores de los botones
local function updateUI(farmingState)
    if farmingState then
        -- Modo activo: OFF se apaga (Gris) y ON se enciende (Verde)
        offButton.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
        onButton.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
    else
        -- Modo inactivo (Estado pedido por usuario): OFF en Verde, ON en Gris
        offButton.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
        onButton.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
    end
end

-- Interacción: Al presionar OFF se activa el farm rápido
offButton.MouseButton1Click:Connect(function()
    updateUI(true)
    saveState(true)
    fakeRemote:FireServer("START") -- Envío simulado
    startFarming()
end)

-- Interacción: Al presionar ON se detiene el farm rápido
onButton.MouseButton1Click:Connect(function()
    updateUI(false)
    saveState(false)
    fakeRemote:FireServer("STOP") -- Envío simulado
    stopFarming()
end)

-- Carga automática al entrar al servidor
local savedStatus = loadState()
if savedStatus == true then
    updateUI(true)
    startFarming()
else
    updateUI(false)
end
