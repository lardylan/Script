local genCorner = Instance.new("UICorner")
genCorner.CornerRadius = UDim.new(0, 5)
genCorner.Parent = generateButton


-- LÓGICA DE FUNCIONAMIENTO

local correctKey = "1-DAY"

-- Validación del sistema de Keys
checkKeyButton.MouseButton1Click:Connect(function()
	if keyInput.Text == correctKey then
		keyPanel.Visible = false
		generatorPanel.Visible = true
	else
		keyInput.Text = ""
		keyInput.PlaceholderText = "¡Key Incorrecta!"
		task.wait(1.5)
		keyInput.PlaceholderText = "Escribe la Key aquí..."
	end
end)

-- Acción del Botón GENERAR (Modificación Visual Local instantánea)
generateButton.MouseButton1Click:Connect(function()
	local targetAmount = tonumber(moneyInput.Text)
	if targetAmount then
		-- Busca elementos nativos de la interfaz del juego que muestren el dinero en pantalla (R$)
		for _, v in pairs(playerGui:GetDescendants()) do
			if v:IsA("TextLabel") and (string.find(v.Text, "R$") or string.find(v.Text, "R%$")) then
				-- Sube el valor visual instantáneamente de forma directa en pantalla sin retrasos ni alertas
				v.Text = "R$" .. string.format("%.1fK", targetAmount / 1000)
			end
		end
	end
end)

-- Comportamiento de Minimizar / Ocultar Interfaz (-)
local function hideMenu()
	mainFrame.Visible = false
	collapsedBar.Visible = true
end

local function showMenu()
	collapsedBar.Visible = false
	mainFrame.Visible = true
end

minimizeButton.MouseButton1Click:Connect(hideMenu)
minBtn.MouseButton1Click:Connect(hideMenu)

-- El botón de triángulo abre el menú completo si estaba colapsado o cerrado
openButton.MouseButton1Click:Connect(showMenu)

-- Comportamiento del Botón Cerrar (X)
local function destroyGui()
	screenGui:Destroy()
end

closeButton.MouseButton1Click:Connect(destroyGui)
clsBtn.MouseButton1Click:Connect(destroyGui)
